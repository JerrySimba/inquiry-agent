# Neon pooled connection (recommended for app / Vercel)
DATABASE_URL=postgresql://USER:PASS@HOST-pooler/neondb?sslmode=require
AUTH_SECRET=change-me-to-a-long-random-string
OPENAI_API_KEY=
# Optional: leave empty to use deterministic demo embeddings + heuristic agent

# false = Neon/Postgres; true = local .data/store.json
USE_LOCAL_STORE=false
# LOCAL_STORE_PATH=./.data/store.json

# WhatsApp Cloud API (or connect via Dashboard → Channels)
WHATSAPP_VERIFY_TOKEN=inquiry-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Gmail OAuth (Google Cloud Console → OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI to allow: {NEXT_PUBLIC_APP_URL}/api/channels/gmail/callback

# Optional email fallback (Resend) if not using Gmail
RESEND_API_KEY=
EMAIL_INBOUND_SECRET=inquiry-email-secret
EMAIL_FROM=noreply@example.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=true
