# Neon pooled connection (required on Vercel)
DATABASE_URL=postgresql://USER:PASS@HOST-pooler/neondb?sslmode=require

# Auth (required) — generate a long random string
AUTH_SECRET=change-me-to-a-long-random-string

# Public app URL — use your Vercel URL in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# false = Neon/Postgres (required for Vercel)
USE_LOCAL_STORE=false

# Optional LLM (else heuristic + demo embeddings)
OPENAI_API_KEY=

# WhatsApp Cloud API (or connect via Dashboard → Channels)
WHATSAPP_VERIFY_TOKEN=inquiry-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Gmail OAuth (Google Cloud Console → OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production redirect URI:
#   https://YOUR-APP.vercel.app/api/channels/gmail/callback

# Optional email fallback (Resend) if not using Gmail
RESEND_API_KEY=
EMAIL_INBOUND_SECRET=inquiry-email-secret
EMAIL_FROM=noreply@example.com

DEMO_MODE=true

# Protects /api/cron/gmail-sync (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=change-me-long-random

# Gmail Push (near real-time) — Google Cloud Pub/Sub topic
# Format: projects/YOUR_PROJECT_ID/topics/gmail-push
GMAIL_PUBSUB_TOPIC=
# Optional token query param on push URL
GMAIL_PUSH_TOKEN=change-me-push-token

